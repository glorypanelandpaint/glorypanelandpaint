---
import { homeServices, type HomeService } from '../../../data/services';

interface Props {
	/** Cards to show. Defaults to the home page services. */
	services?: HomeService[];
}

const { services = homeServices } = Astro.props;

/** "glory-card" plus its modifiers; a card without href or onlyOn stays class="glory-card". */
const cardClass = (service: HomeService) =>
	['glory-card', service.href && 'glory-card--link', service.onlyOn && `glory-card--${service.onlyOn}-only`]
		.filter(Boolean)
		.join(' ');
---

<div class="glory-grid">
	{
		services.map((service) =>
			service.href ? (
				<a class={cardClass(service)} href={service.href}>
					<div class="glory-disc">
						<svg viewBox="0 0 24 24" aria-hidden="true" set:html={service.iconSvg} />
					</div>
					<h3>{service.title}</h3>
					<p>{service.description}</p>
					<span class="glory-card__more">
						Learn more <span aria-hidden="true">&rarr;</span>
					</span>
				</a>
			) : (
				<div class={cardClass(service)}>
					<div class="glory-disc">
						<svg viewBox="0 0 24 24" aria-hidden="true" set:html={service.iconSvg} />
					</div>
					<h3>{service.title}</h3>
					<p>{service.description}</p>
				</div>
			),
		)
	}
</div>
