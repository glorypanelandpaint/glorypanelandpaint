---
import HeroPhoto from '../../react/HeroPhoto';

interface Props {
  eyebrow?: string;
  centered?: boolean;
  photo?: boolean;
  padding?: string;
}

const { eyebrow, centered = false, photo = false, padding } = Astro.props;
---

<section
  class:list={[
    "glory-section",
    "glory-hero",
    "glory-sunburst",
    photo && "glory-hero--photo",
  ]}
  style={padding}
>
  {photo && <HeroPhoto client:load />}
  <div class:list={["glory-inner", centered && "glory-center"]}>
    {eyebrow && (
      <div
        class:list={[
          "glory-eyebrow-row",
          Astro.slots.has("eyebrow-extra") && "glory-eyebrow-row--compact",
        ]}
      >
        <span class="glory-eyebrow" set:html={eyebrow} />
        <slot name="eyebrow-extra" />
      </div>
    )}
    <slot />
  </div>
</section>
