---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/astro/sections/PageHero.astro';
import GloryGoldText from '../../components/astro/GloryGoldText.astro';
import { getPageSeo } from '../../data/seo';
import { advantageCards } from '../../data/services';
import { images } from '../../data/images';
import './styles.scss';

const seo = getPageSeo('about');

// The tiles have a 280px minimum height, so narrow ones (screens 881-1100px wide, phones under ~375px)
// trim the photos at the sides. Both Porsches sit on the left of their photos: keep the crop anchored
// left so the car and its GLORY plate stay in view.
const showcaseImages = [
	{
		src: images.porsche911Grey,
		alt: 'Grey Porsche 911 outside the GLORY Panel & Paint workshop in Hornby, Christchurch',
		position: 'left center',
	},
	{
		src: images.ferrariUrusWide,
		alt: 'Red Ferrari California and Lamborghini Urus outside the GLORY Panel & Paint workshop in Hornby, Christchurch',
	},
	{
		src: images.porsche911Yellow,
		alt: 'Yellow Porsche 911 outside the GLORY Panel & Paint workshop in Hornby, Christchurch',
		position: 'left center',
	},
];
---

<BaseLayout seo={seo}>
	<div class="glory">
		<PageHero eyebrow="About us" centered padding="padding:84px 24px 56px;">
			<h1 style="margin:14px auto 0;">
				Christchurch&rsquo;s trusted <GloryGoldText text="panel & paint" /> shop
			</h1>
			<p class="glory-sub" style="margin:16px auto 0;">
				A local team that treats every repair like it&rsquo;s our own car.
			</p>
		</PageHero>

		<section class="glory-section glory-bg-black">
			<div class="glory-inner">
				<div class="glory-2col">
					<div class="glory-photo">
						<img
							src={images.forecourtCars}
							alt="Porsche, Ferrari and other premium cars at GLORY Panel & Paint in Hornby, Christchurch"
							loading="lazy"
							width="560"
							height="420"
						/>
					</div>
					<div>
						<span class="glory-eyebrow">Our story</span>
						<h2>Quality, honesty, and a job done right</h2>
						<p>
							GLORY Panel &amp; Paint is a leading provider of quality panel beating and paint
							services in Christchurch. We strive for perfection when it comes to our work and
							ensure that all of our customers are satisfied with the end results.
						</p>
						<p style="margin-top:14px;">
							We provide a range of services, from minor repairs to major panel and paint
							restorations. We guarantee that our service is high-quality, trustworthy and reliable.
						</p>
						<p style="margin-top:14px;">
							With us, you can have the peace of mind knowing that your vehicle is in the best hands.
						</p>
					</div>
				</div>
			</div>
		</section>

		<section class="glory-section glory-bg-layer">
			<div class="glory-inner">
				<div class="glory-head">
					<span class="glory-eyebrow">What sets us apart</span>
					<h2>Built on quality</h2>
				</div>
				<div class="glory-grid">
					{
						advantageCards.map((card) => (
							<div class="glory-card">
								<div class="glory-disc">
									<svg viewBox="0 0 24 24" aria-hidden="true" set:html={card.iconSvg} />
								</div>
								<h3>{card.title}</h3>
								<p>{card.description}</p>
							</div>
						))
					}
				</div>
				<div style="margin-top:46px;text-align:center;">
					<span class="glory-eyebrow">The cars people trust us with</span>
				</div>
				<div class="glory-grid" style="margin-top:18px;">
					{
						showcaseImages.map((img) => (
							<div class="glory-photo">
								<img
									src={img.src}
									alt={img.alt}
									loading="lazy"
									width="360"
									height="270"
									style={img.position ? `object-position: ${img.position};` : undefined}
								/>
							</div>
						))
					}
				</div>
			</div>
		</section>

		<section class="glory-section glory-cta glory-sunburst">
			<div class="glory-inner glory-center">
				<h2>Come see us in Hornby</h2>
				<div class="glory-btns" style="justify-content:center;">
					<a class="glory-btn-gold" href="/contact/">Contact us</a>
					<a class="glory-btn-outline" href="/book-online/">Book Online</a>
				</div>
				<div class="glory-meta">13–15 Smarts Rd, Hornby, Christchurch 8042 · 03 420 2022</div>
			</div>
		</section>
	</div>
</BaseLayout>
