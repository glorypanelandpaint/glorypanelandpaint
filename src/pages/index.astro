---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/astro/sections/PageHero.astro";
import GloryGoldText from "../components/astro/GloryGoldText.astro";
import HomeServiceGrid from "../components/astro/sections/HomeServiceGrid.astro";
import PhotoStrip from "../components/astro/sections/PhotoStrip.astro";
import InsurerChips from "../components/astro/sections/InsurerChips.astro";
import ReviewMarquee from "../components/astro/sections/ReviewMarquee.astro";
import CTASection from "../components/astro/sections/CTASection.astro";
import { getPageSeo } from "../data/seo";
import { autoBodyShopSchema } from "../lib/schema";
import "./index.scss";

const seo = getPageSeo("home");
---

<BaseLayout seo={seo} schema={autoBodyShopSchema()}>
  <div class="glory">
    <PageHero eyebrow={`Christchurch · <br class="glory-eyebrow-break" />Panel Beating &amp; Spray Paint`} photo>
      <div slot="eyebrow-extra" class="glory-hero-badges-mobile">
        <span class="glory-badge glory-badge--cra">
          <img
            src="/images/badge-cra.webp"
            alt="Collision Repair Association (CRA)"
            width="160"
            height="160"
            loading="lazy"
            decoding="async"
          />
        </span>
        <span class="glory-badge">
          <img
            src="/images/badge-mta.webp"
            alt="MTA Assured"
            width="160"
            height="160"
            loading="lazy"
            decoding="async"
          />
        </span>
        <a
          class="glory-badge glory-badge--top5"
          href="https://www.top5.nz/panel-beaters/christchurch/"
          target="_blank"
          rel="noopener noreferrer"
        >
          <img
            src="/images/badge-top5nz.webp"
            alt="Top5.nz #1 Panel Beater Christchurch"
            width="320"
            height="160"
            loading="lazy"
            decoding="async"
          />
        </a>
      </div>
      <h1>Reignite Your <GloryGoldText text="GLORY" /></h1>
      <p class="glory-sub">
        GLORY Panel &amp; Paint is a leading provider of quality panel beating
        and spray painting services in Christchurch. We strive for perfection
        and guarantee work
        that&rsquo;s high-quality, trustworthy and reliable, so you have peace
        of mind your vehicle is in the best hands.
      </p>
      <div class="glory-btns-row">
        <div class="glory-btns">
          <a class="glory-btn-gold" href="/contact/">Get a Free Quote</a>
          <a class="glory-btn-outline" href="/book-online/">Book Online</a>
        </div>
        <div class="glory-hero-badges">
          <span class="glory-badge glory-badge--cra">
            <img
              src="/images/badge-cra.webp"
              alt="Collision Repair Association (CRA)"
              width="160"
              height="160"
              loading="lazy"
              decoding="async"
            />
          </span>
          <span class="glory-badge">
            <img
              src="/images/badge-mta.webp"
              alt="MTA Assured"
              width="160"
              height="160"
              loading="lazy"
              decoding="async"
            />
          </span>
          <a
            class="glory-badge glory-badge--top5"
            href="https://www.top5.nz/panel-beaters/christchurch/"
            target="_blank"
            rel="noopener noreferrer"
          >
            <img
              src="/images/badge-top5nz.webp"
              alt="Top5.nz #1 Panel Beater Christchurch"
              width="320"
              height="160"
              loading="lazy"
              decoding="async"
            />
          </a>
        </div>
      </div>
      <div class="glory-trust">
        <span>&#9733;&#9733;&#9733;&#9733;&#9733; <b>5.0</b> on Google</span>
        <span><span class="glory-tick">&#10003;</span> Free courtesy car</span>
        <span>
          <span class="glory-tick">&#10003;</span> All insurance claims</span
        >
        <span
          ><span class="glory-tick">&#10003;</span> Quality workmanship
        </span>
      </div>
    </PageHero>

    <section class="glory-section glory-bg-layer">
      <div class="glory-inner">
        <div class="glory-head">
          <span class="glory-eyebrow">What we do</span>
          <h2>Our Services</h2>
        </div>
        <HomeServiceGrid />
      </div>
    </section>

    <section class="glory-section glory-bg-black">
      <div class="glory-inner">
        <PhotoStrip />
      </div>
    </section>

    <section class="glory-section glory-bg-black glory-center">
      <div class="glory-inner">
        <div class="glory-head"><h2>We accept all insurance claims</h2></div>
        <InsurerChips />
      </div>
    </section>

    <ReviewMarquee />

    <CTASection
      title="Ready to get started?"
      subtitle="Get a free, no-obligation quote on your repair — send us a few photos and we'll be in touch."
      buttonLabel="Get a Free Quote →"
      buttonHref="/contact/"
      showMeta
    />
  </div>
</BaseLayout>
